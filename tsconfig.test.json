{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true
  },
  "include": ["src/**/*", "test/**/*", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "coverage"]
}
