{
  "name": "gtm-diff",
  "version": "0.1.0",
  "description": "CLI toolkit for Google Tag Manager: diff between container exports, plan for sync, apply for real pushes. Terraform-style DX.",
  "keywords": [
    "gtm",
    "google-tag-manager",
    "diff",
    "tag-manager",
    "cli",
    "devops",
    "code-review"
  ],
  "license": "MIT",
  "author": "Dilshat Rakhimov",
  "repository": {
    "type": "git",
    "url": "https://github.com/arcbaslow/gtm-diff.git"
  },
  "homepage": "https://github.com/arcbaslow/gtm-diff#readme",
  "bugs": "https://github.com/arcbaslow/gtm-diff/issues",
  "type": "module",
  "bin": {
    "gtm-diff": "./bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist oclif.manifest.json",
    "dev": "tsx ./bin/dev.js",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run clean && npm run build && oclif manifest && oclif readme",
    "postpack": "rimraf oclif.manifest.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-help": "^6.2.0",
    "chalk": "^5.3.0",
    "microdiff": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^9.1.0",
    "oclif": "^4.14.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "oclif": {
    "bin": "gtm-diff",
    "dirname": "gtm-diff",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " "
  }
}
